# Copy this file to .env.production and replace every replace-* value.
# Run Compose with: docker compose --env-file .env.production -f docker-compose.production.yml ...

NODE_ENV=production
PORT=4000

# The Next server calls the API over the private Compose network.
DEARLY_API_URL=http://api:4000/api/v1

# Browser requests stay same-origin behind Nginx.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_AUTH_URL=https://dearly.example.com
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=true
WEB_ORIGIN=https://dearly.example.com
BETTER_AUTH_URL=https://dearly.example.com
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Neon: pooled URL for runtime traffic, direct URL for Prisma migrations.
DATABASE_URL=postgresql://neon-user:replace-password@ep-example-pooler.region.aws.neon.tech/dearly?sslmode=require
DIRECT_URL=postgresql://neon-user:replace-password@ep-example.region.aws.neon.tech/dearly?sslmode=require

# Managed Redis. Prefer a TLS URL in production.
REDIS_URL=rediss://default:replace-password@redis.example.com:6380

# Google OAuth callback: https://dearly.example.com/api/auth/callback/google
GOOGLE_AUTH_MODE=google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@dearly.example.com

AUTH_RATE_LIMIT_ENABLED=true

MEDIA_STORAGE_DRIVER=r2
MEDIA_UPLOAD_INTENT_TTL_SECONDS=900
LETTER_RETENTION_CLEANUP_INTERVAL_MINUTES=1440
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=dearly-media
R2_PUBLIC_URL=

# Mounted by the Nginx container. Keep certificate files outside Git.
NGINX_TLS_DIR=./infra/nginx/tls
NGINX_ACME_WEBROOT=./infra/nginx/acme
