# Web server -> API server communication. Use http://api:4000/api/v1 when the
# Next.js server runs in the Docker network.
DEARLY_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_AUTH_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://127.0.0.1:3000

# Keep runtime DATABASE_URL pooled in production and use DIRECT_URL for Prisma migrations.
DATABASE_URL=postgresql://dearly:dearly@127.0.0.1:5432/dearly
DIRECT_URL=postgresql://dearly:dearly@127.0.0.1:5432/dearly
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://127.0.0.1:4000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@dearly.dev

# Cloudflare R2 (added when the media upload slice is implemented).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dearly-media
R2_PUBLIC_URL=

# Redis (used for queues, rate limiting, and short-lived coordination).
REDIS_URL=redis://127.0.0.1:6379
