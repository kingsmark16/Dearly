{
  "name": "@dearly/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "pretest": "pnpm --filter @dearly/contracts build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@dearly/contracts": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "joi": "18.2.8",
    "nodemailer": "10.0.0",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
